[Unit]
Description=MGAR V3 Engine and local API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mgar
Group=mgar
WorkingDirectory=/opt/mgar/v3
EnvironmentFile=/etc/mgar/server.env
ExecStart=/opt/mgar/v3/.venv/bin/uvicorn mgar_v3.api:create_app --factory --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/mgar/v3/.local
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
